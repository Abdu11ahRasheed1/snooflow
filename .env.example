# PostgreSQL connection string (Neon, Supabase, or Netlify DB)
# Leave empty locally to use the automatic local JSON fallback (data/db.json)
DATABASE_URL=

# Secret key for JWT auth tokens (use a long random string in production)
JWT_SECRET=change-this-to-a-long-random-secret

# 32-byte hex or passphrase for encrypting stored API keys
ENCRYPTION_SECRET=change-this-to-another-long-secret
